+}
+#ifdef M3_RESONATOR
+extern "C" {
+u32 tr_click(u32,u32,u32) __asm__("m3_setup_click");
+void tr_receive(u32,u32,i32) __asm__("m3_receive");
+u32 tr_step(u32,u32,u32) __asm__("m3_step");
+u32 tr_project() __asm__("m3_project");
+void tr_new() __asm__("m3_new");
+void* tr_copy(void*,const void*,u32) __asm__("m3_copy");
+}
+#endif
+int sept_setup_register() {
+    return sdk_register_screen(&sept_ui::screen_record,&sept_ui::main_screen);
+}
+u32 sept_setup_frame(u32 selected) {
+    using namespace sept_ui;
+    render_page = 0;
+    const u32 track = opxy::platform::byte(opxy::platform::kSelectedTrack);
+    if (selected != 3 || !context(track) || !plain()) {
+        menu_pattern = 0;
+        return 0;
+    }
+    publish_track(active(),track);
+    menu(track);
+    if (sdk_screen_ready(&screen_record, &main_screen)) render_page = main_page;
+    return render_page;
+}
+namespace sept_ui {
+bool change(u32 track, int slot, u32 next) {
+    if (next == saved.word[slot]) return false;
+    saved.word[slot] = next;
+    publish_track(active(),track);
+    stock<void()>(0x8d585ee8)();
+    return true;
+}
+}
+u32 sept_setup_click(u32 track,u32 key,u32 controller) {
+    using namespace sept_ui;
+    if (key >= 11 && key <= 13 && context(track) && plain()
+            && sdk_screen_ready(&screen_record, &main_screen)) {
+        const u32 pattern = pattern_for(track);
+        const int slot = index_of(active(), pattern);
+        if (slot >= 0 && key == 11) {
+            menu_pattern = menu_pattern == pattern ? 0 : pattern;
+            return 0;
+        }
+        if (slot >= 0 && key == 12) {
+            // Stock gain words are bipolar around half scale. Word 19 is the sweep.
+            for (u32 index = 16; index < 19; ++index)
+                set_parameter(gui_project, track, index, 0x40000000);
+            if (!change(track, slot, saved.word[slot] & ~extra_gain_mask))
+                stock<void()>(0x8d585ee8)();
+            return 0;
+        }
+        if (slot >= 0 && key == 13 && !menu(track)) {
+            change(track,slot,cycle(saved.word[slot]));
+            return 0;
+        }
+    }
+
+#ifdef M3_RESONATOR
+    return tr_click(track,key,controller);
+#else
+    return m3_stock_click(track,key,controller);
+#endif
+
+}
+int sept_setup_turn(u32 track,u32 index,u32 event) {
+    using namespace sept_ui;
+    if (index < 16 || index > 19 || !menu(track) || !plain()) return -1;
+    const int slot = index_of(active(), menu_pattern);
+    if (slot < 0 || !event) return 0;
+    return change(track,slot,edit(saved.word[slot], index-16, at<const i32>(event)[1]));
+}
+void sept_receive(u32 base,u32 id,i32 value) {
+    using namespace sept_ui;
+    if (id != private_message || !(u32(value)&0x80000000u)) {
+#ifdef M3_RESONATOR
+    tr_receive(base,id,value);
+#else
+    stock<void(u32,u32,i32)>(0x8d50eb8c)(base,id,value);
+#endif
+        return;
+    }
+    const u32 t = (u32(value) & 0x7fffffffu) >> setup_bits, settings = u32(value) & setup_mask;
+    if (t < tracks && valid_setup(settings)) audio[t] = settings;
+}
+u32 sept_stock_step(u32 project,u32 track,u32 position) {
+    return stock<u32(u32,u32,u32)>(0x8d5936c0)(project,track,position);
+}
+u32 sept_step(u32 project,u32 track,u32 position) {
+
+#ifdef M3_RESONATOR
+    const u32 result = tr_step(project,track,position);
+#else
+    const u32 result = sept_step_base(project,track,position);
+#endif
+
+    if (track < sept_ui::tracks) sept_ui::publish_track(sept_ui::active(),track);
+    return result;
+}
+u32 sept_project() {
+    using namespace sept_ui;
+
+#ifdef M3_RESONATOR
+    const u32 project = tr_project();
+#else
+    const u32 project = stock<u32()>(0x8d584210)();
+#endif
+
+    if (project && project == pending_project) saved = pending;
+    else for (u32 i = 0; i < slots; ++i) saved.word[i] = initial_settings;
+    pending_project = menu_pattern = 0;
+    for (u32 t = 0; t < tracks; ++t) sent[t] = false;
+    refresh();
+    return project;
+}
+void sept_new() { sept_ui::pending_project = 0;
+#ifdef M3_RESONATOR
+    tr_new();
+#else
+    m3_stock_new();
+#endif
+}
+void* sept_copy(void* dst, const void* src, u32 bytes) {
+    using namespace sept_ui;
+    const u32 to = reinterpret_cast<Address>(dst), from = reinterpret_cast<Address>(src);
+    if (bytes == pattern_bytes) {
+        const u32 project = active();
+        const int a = index_of(project, from), b = index_of(project, to);
+        const u32 setting = a >= 0 ? saved.word[a] : from == clipboard ? copied : initial_settings;
+        if (to == clipboard) copied = setting;
+        if (b >= 0) saved.word[b] = setting;
+    }
+
+#ifdef M3_RESONATOR
+    return tr_copy(dst,src,bytes);
+#else
+    return stock<void*(void*,const void*,u32)>(0x040201c4)(dst,src,bytes);
+#endif
+
+}
+// Companion callbacks execute on the GUI role. Restore is staged until stock
+// publishes the deserialized project buffer.
+extern "C" {
+unsigned sept_saved(unsigned) __asm__("sept_saved");
+void sept_loaded(unsigned, const opxy::u8*, unsigned) __asm__("sept_loaded");
+}
+unsigned sept_saved(unsigned i) { return i < sept_ui::slots ? sept_ui::saved.word[i] : 0; }
+void sept_loaded(unsigned project, const opxy::u8* bytes, unsigned width) {
+    sept_ui::pending_project = project;
+    for (unsigned i = 0; i < sept_ui::slots; ++i) {
+        unsigned word = 0;
+        if (!bytes || !width) word = sept_ui::initial_settings;
+        if (bytes && (width == 2 || width == 4))
+            for (unsigned j = 0; j < width; ++j)
+                word |= unsigned(bytes[i * width + j]) << (8 * j);
+
+        sept_ui::pending.word[i] = septet_eq::valid_setup(word) ? word : 0;
+    }
+}
