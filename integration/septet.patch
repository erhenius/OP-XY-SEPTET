diff --git a/sdk/platform/opxy-1.2.1/septet.cpp.in b/sdk/platform/opxy-1.2.1/septet.cpp.in
new file mode 100644
index 0000000..dc8b52a
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/septet.cpp.in
@@ -0,0 +1,135 @@
+// OS 1.2.1 track-sum EQ. The stock filter registrar populates
+// the per-voice factory table and its name map, independently of send FX.
+#include "registration.hpp"
+// The FX build carrier has no separate authored source-unit slot.
+#include "eq.hpp"
+
+using opxy::u32;
+using opxy::i32;
+using opxy::platform::Address;
+using opxy::platform::Record;
+using opxy::platform::at;
+using opxy::platform::stock;
+
+extern "C" {
+extern const char septet_fx_factory[] __asm__("septet_fx_factory");
+extern const char septet_fx_parameter_name[] __asm__("septet_fx_parameter_name");
+int septet_fx_register() __asm__("septet_fx_register");
+int septet_ready() __asm__("septet_ready");
+void septet_filter_init(u32, const char*, const char*, const char*, u32)
+    __asm__("septet_filter_init");
+}
+
+static constexpr u32 kSeptetFilter = @SEPTET_FILTER@;
+#include "septet_ui.hpp"
+
+namespace {
+const Address kFilterRecords = 0x08039b2c;
+const u32 kRegisterFilter = 0x8d50673c;
+const u32 kStockSvf = 10;
+const u32 kStockSvfFactory = 0x8d51c058;
+const Address kStockSvfMethods = 0x8405307c;
+const u32 kStockVoiceCount = 128;
+const u32 kStockSlotBytes = 0x90;
+const unsigned kFilterControlOffset = 16;
+const u32 kInstrumentFilterPage = 3;
+const u32 kRecordWords = 12;
+const u32 kNameBytes = 32;
+
+
+using Registrar = void(u32, const char*, const char*, const char*, u32);
+
+const volatile u32* row(u32 id) {
+    return at<const volatile u32>(kFilterRecords) + id * kRecordWords;
+}
+
+bool name_matches(const volatile u32* record, const char* name, u32 size) {
+    const volatile char* field = reinterpret_cast<const volatile char*>(record + 4);
+    for (u32 i = 0; i < kNameBytes; ++i) {
+        if (field[i] != (i < size ? name[i] : 0)) return false;
+    }
+    return true;
+}
+
+bool empty(const volatile u32* record) {
+    for (u32 i = 0; i < kRecordWords; ++i) {
+        if (record[i] != 0) return false;
+    }
+    return true;
+}
+
+struct FilterObject { const void* const* methods; };
+using namespace septet_eq;
+Bank track_bank[8];
+void mono(FilterObject*, i32*, const i32*, i32, i32) {}
+void stereo(FilterObject*, i32*, const i32*, i32, i32) {}
+void reset(FilterObject*, u32) {}
+const void* const kPassThroughMethods[10] = {
+    reinterpret_cast<const void*>(0x8d51c0c2), reinterpret_cast<const void*>(0x8d51c0d8),
+    reinterpret_cast<const void*>(&mono), reinterpret_cast<const void*>(&stereo),
+    reinterpret_cast<const void*>(0x8d5006a4), reinterpret_cast<const void*>(&reset),
+    reinterpret_cast<const void*>(0x8d51bc20), reinterpret_cast<const void*>(0x8d500684),
+    nullptr, nullptr
+};
+
+void* septet_factory(u32 index, u32 track) {
+    if (index >= kStockVoiceCount) return nullptr;
+    auto object = stock<FilterObject*(u32, u32)>(kStockSvfFactory)(index, track);
+    if (object && object->methods == at<const void* const>(kStockSvfMethods)) {
+        object->methods = kPassThroughMethods;
+        reset(object, 0);
+    }
+    return object;
+}
+
+const char kFilterName[] = "septet";
+}
+
+int septet_ready() {
+    const volatile u32* svf = row(kStockSvf);
+    const volatile u32* probe = row(kSeptetFilter);
+    return svf[0] == kStockSvfFactory &&
+           probe[0] == reinterpret_cast<Address>(septet_factory) &&
+           probe[1] == reinterpret_cast<Address>(septet_fx_parameter_name) &&
+           probe[3] == svf[3] && name_matches(probe, kFilterName, sizeof(kFilterName)-1);
+}
+
+int septet_fx_register() {
+    const Record record = {septet_fx_factory, septet_fx_parameter_name, kFilterName,
+                           at<const char>(kSeptetFilter), at<const char>(kInstrumentFilterPage), 0};
+    return sdk_register_effect(&record) > 0;
+}
+
+void septet_filter_init(u32 id, const char* name, const char* factory,
+                         const char* parameters, u32 page) {
+    const auto register_filter = stock<Registrar>(kRegisterFilter);
+    // Reproduce the final stock registration (Dynamic) with its original ABI.
+
+#ifdef M3_RESONATOR
+    extern void install_trine(u32,const char*,const char*,const char*,u32) __asm__("m3probe_filter_init");
+    install_trine(id,name,factory,parameters,page);
+#else
+    register_filter(id,name,factory,parameters,page);
+#endif
+
+    const volatile u32* svf = row(kStockSvf);
+    if (svf[0] != kStockSvfFactory ||
+        !name_matches(svf, "svf", 3)) return;
+    if (empty(row(kSeptetFilter))) {
+        register_filter(kSeptetFilter, kFilterName, reinterpret_cast<const char*>(septet_factory),
+                        septet_fx_parameter_name, svf[3]);
+    }
+}
+
+extern "C" void septet_sum(u32) __asm__("septet_sum");
+void septet_sum(u32 track) {
+    if(track>=8)return;
+    auto& bank=track_bank[track];
+    if(!at<const volatile unsigned char>(0x11b01dc8)[track] ||
+       at<const volatile u32>(0x84042700)[track]!=kSeptetFilter){
+        if(bank.started)bank={};
+        return;
+    }
+    const auto words=at<const i32>(0x84eab39c+0xe8*track)+kFilterControlOffset;
+    septet_eq::process(bank,septet_eq::controls(words,sept_ui::audio[track]),at<i32>(0x11903600),64);
+}
diff --git a/sdk/platform/opxy-1.2.1/septet_sum_hook.s b/sdk/platform/opxy-1.2.1/septet_sum_hook.s
new file mode 100644
index 0000000..34d4c9d
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/septet_sum_hook.s
@@ -0,0 +1,15 @@
+/* Same reviewed mixer boundary as sdk_drum_send_gain_hook, stock OS 1.2.1. */
+.include "sdk/platform/opxy-1.2.1/hook.inc"
+.section .text
+.align 2
+.global septet_sum_hook
+.type septet_sum_hook, STT_FUNC
+septet_sum_hook:
+    HOOK_SAVE
+    P0 = [FP];
+    R0 = [P0 + 8];
+    CALL septet_sum;
+    HOOK_RESTORE
+    P2.H = 0x1190; P2.L = 0x3600;
+    RTS;
+.size septet_sum_hook, .-septet_sum_hook
diff --git a/sdk/platform/opxy-1.2.1/septet_ui.hpp b/sdk/platform/opxy-1.2.1/septet_ui.hpp
new file mode 100644
index 0000000..84fdb7b
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/septet_ui.hpp
@@ -0,0 +1,375 @@
+// Included in the generated registration translation unit for this isolated build.
+#include "screen.hpp"
+#include "settings.hpp"
+#include "graph_paths.hpp"
+namespace sept_ui {
+using namespace opxy;
+using namespace opxy::platform;
+using namespace septet_eq;
+constexpr u32 tracks = 8, patterns = 16, slots = tracks * patterns;
+constexpr u32 pattern_bytes = 0x53f4, track_bytes = 0x53f44;
+constexpr u32 clipboard = 0x84ffd208, private_message = 128;
+constexpr u32 gui_project = 0x86bd027c;
+constexpr u32 main_page = SEPTET_PAGE;
+constexpr u32 initial_settings = 0;
+struct Settings { u32 word[slots]; };
+Settings saved, pending;
+u32 pending_project, menu_pattern, last_sent[tracks];
+u32 render_page;
+bool sent[tracks];
+u32 copied;
+u32 audio[tracks];
+u32 active() { return word(0x840a0524); }
+u32 pattern_for(u32 t) { return stock<u32(u32)>(0x8d587708)(t); }
+int index_of(u32 project, u32 pointer) {
+    if (!project || pointer < project + 0xd7c) return -1;
+    const u32 offset = pointer - project - 0xd7c;
+    if (offset >= tracks * track_bytes) return -1;
+    const u32 track = offset / track_bytes, within = offset % track_bytes;
+    if (within % pattern_bytes || within >= patterns * pattern_bytes) return -1;
+    return int(track * patterns + within / pattern_bytes);
+}
+bool context(u32 track) {
+    if (track >= tracks || track != byte(kSelectedTrack) || word(0x080238bc) != 2 || word(kScreen) != 0) return false;
+    auto controller = stock<const u32*()>(0x8c0944b0)();
+    return controller && *controller == 0x8400dff8 && stock<u32(u32)>(0x8d5878d4)(track) == kSeptetFilter;
+}
+bool plain() { return !stock<u32(u32)>(0x8d5b7d7c)(14u + byte(kSelectedTrack)) && !shift_held() && !stock<u32()>(0x8d5b7e34)(); }
+void send(u32 track, u32 value) {
+    if (!sent[track] || last_sent[track] != value) {
+        stock<void(u32,i32)>(0x8d4dc84c)(private_message, i32(0x80000000u | (track << setup_bits) | value));
+        sent[track] = true;
+        last_sent[track] = value;
+    }
+}
+void publish_track(u32 project,u32 track) {
+    const u32 playing = stock<u32(u32)>(0x8d586014)(track);
+    const int slot = index_of(project, playing);
+    if (slot >= 0) send(track, saved.word[slot]);
+}
+void refresh() {
+    const u32 project = active();
+    if (!project || word(0x840a0528)) return;
+    for (u32 t = 0; t < tracks; ++t) publish_track(project,t);
+}
+bool menu(u32 t) {
+    if (menu_pattern && (!context(t) || menu_pattern != pattern_for(t))) menu_pattern = 0;
+    return menu_pattern != 0;
+}
+namespace {
+using namespace opxy::screen;
+using namespace septet_graph;
+struct Renderer {
+    struct Path {
+        PathNode* node;
+        u32 begin;
+
+        Command* commands(unsigned count) const {
+            if (!node) return nullptr;
+            const auto& v=node->commands;
+            if (!ordered(v) || (v.begin&3) || v.end-v.begin!=count*sizeof(Command)) return nullptr;
+            return reinterpret_cast<Command*>(v.begin);
+        }
+        void bind(PathNode* leaf,unsigned count) {
+            node=leaf;
+            const auto* data=commands(count);
+            if (data && valid_polygon(data,count)) begin=node->commands.begin;
+        }
+        void paint(const int* y,unsigned count,int inset) const {
+            if (!begin || node->commands.begin!=begin) return;
+            auto* data=commands(count);
+            if (!data) return;
+            if (count==ribbon_commands) write_ribbon(data,y,inset);
+            else write_contour(data,y,inset);
+            invalidate(node);
+        }
+    };
+    struct Object {
+        Base base;
+        Path curve,area,secondary;
+        PathNode *dot[7],*icon[9],*handle,*sweep_dot;
+        u16 palette[12], dot_stroke[2];
+        septet_eq::Controls last;
+        u32 bank,initialized;
+    };
+    static PathNode* node(Object* o,const char* name){return path_node(find(&o->base,name));}
+    static PathNode* indexed(Object* o,const char* prefix,unsigned n) {
+        char id[12];char* p=id;
+        while(*prefix)*p++=*prefix++;
+        if(n>=10)*p++='1';
+        *p++=char('0'+n%10);*p=0;
+        return node(o,id);
+    }
+    static void init(Object* o) {
+        clear(o); if(!o->base.svg)return;
+        o->curve.bind(node(o,"curve"),ribbon_commands);
+        o->area.bind(node(o,"fillcurve"),contour_commands);
+        o->secondary.bind(node(o,"secondary"),ribbon_commands);
+        o->sweep_dot=node(o,"sweep_dot");
+        o->handle=node(o,"handle");
+        for(unsigned i=0;i<7;++i)o->dot[i]=indexed(o,"dot",i);
+        for(unsigned i=0;i<9;++i)o->icon[i]=indexed(o,"icon",i);
+        for(unsigned i=0;i<12;++i){
+            auto p=indexed(o,"shade",i);
+            if(!p)continue;
+            o->palette[i]=p->fill;
+            if(i>=10)o->dot_stroke[i-10]=palette_ids(p,o->base.svg)>>16;
+        }
+    }
+    static void move(PathNode* p,int x,int y){
+        const u32 indices[]={6,7};const i32 pose[]={x*1024,y*1024};
+        if(p)set_words(&p->leaf,indices,pose);
+    }
+    static void shade(PathNode* p,u16 color){
+        if(p && color && p->fill!=color){set_fill(p,color);invalidate(p);}
+    }
+    static void place_mode(Object* o,Mode mode,int shift) {
+        const unsigned a=3+2*unsigned(mode);
+        move(o->icon[mode],47+shift,197);
+        move(o->icon[a],168+shift,197);
+        move(o->icon[a+1],449+shift,197);
+    }
+    static void frame(Object* o,i32) {
+        if(!render_page || !o->base.svg)return;
+        u32 t=byte(kSelectedTrack);
+        const u32 pattern=pattern_for(t);
+        const int slot=index_of(active(),pattern);
+        if(slot<0)return;
+        const bool upper=menu_pattern==pattern;
+        i32 words[4];
+        for(unsigned i=0;i<4;++i)
+            words[i]=stock<i32(u32,u32,u32,u32)>(0x8d5ac9dc)(gui_project,t,16+i,1);
+        const auto p=controls(words,saved.word[slot]);
+        const bool first=!o->initialized;
+        const bool mode_changed=first || p.mode!=o->last.mode;
+        const bool sweep_changed=first || p.sweep!=o->last.sweep;
+        bool plot_changed=mode_changed || sweep_q12(p.sweep)!=sweep_q12(o->last.sweep);
+        const bool bank_changed=first || o->bank!=unsigned(upper);
+        for(unsigned i=0;i<7;++i){
+            const bool gain_changed=first || p.gain[i]!=o->last.gain[i];
+            if(gain_changed){
+                plot_changed=true;
+                move(o->dot[i],px[dot_index[i]],69-4*p.gain[i]);
+            }
+            if(gain_changed || bank_changed){
+                const unsigned dim=(i>=3)!=upper;
+                const u32 fill=o->palette[p.gain[i]==0 ? 9 : 10+dim];
+                const u32 stroke=o->dot_stroke[dim];
+                if(fill && stroke) paint(o->dot[i],fill | (stroke<<16),true);
+            }
+        }
+        if(plot_changed){
+            int side[points],middle[points];
+            plot(p,side,middle);
+            const bool mid_primary=p.mode==MidSide && p.sweep<16384;
+            const int* primary=mid_primary ? middle : side;
+            o->curve.paint(primary,ribbon_commands,1);
+            o->area.paint(primary,contour_commands,1);
+            if(p.mode==MidSide)
+                o->secondary.paint(mid_primary ? side : middle,ribbon_commands,0);
+        }
+        if(mode_changed){
+            if(p.mode!=o->last.mode) place_mode(o,o->last.mode,-550);
+            place_mode(o,p.mode,0);
+            move(o->secondary.node,p.mode==MidSide ? 0 : -480,0);
+        }
+        if(mode_changed || sweep_changed){
+            const unsigned a=3+2*unsigned(p.mode),light=(p.sweep+2048)>>12;
+            shade(o->icon[a],o->palette[8-light]);
+            shade(o->icon[a+1],o->palette[light]);
+            move(o->handle,190+(235*p.sweep+16384)/32768,197);
+        }
+        if(bank_changed){
+            move(o->sweep_dot,upper ? -480 : 22,197);
+            shade(o->handle,o->palette[upper ? 11 : 10]);
+            o->bank=upper;
+        }
+        o->initialized=1;
+        o->last=p;
+        draw(&o->base);
+    }
+};
+}
