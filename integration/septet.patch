--- /dev/null
+++ b/tooling/septet_support.py
@@ -0,0 +1,58 @@
+"""Compose Septet's filter registration and mixer service with the selected M3 machines."""
+import json
+from .formats import require
+
+def filter_id(machine):
+    # An rc1 layout with carrier 8 keeps its project-visible filter identity.
+    # For all other carriers use a filter-only row: 7 is below the stock
+    # setter bound and outside the SDK send-effect pool on OS 1.2.1.
+    return 8 if machine.identity['effect'] == 8 else 7
+
+
+def configure(profile, machines, layout, trine):
+    from .native import ROOT, FIXED_NUMBERS, active_services, bundle_page_claims, check_patch_boundaries, service_users
+    rules = profile['identities']
+    owners = [m for m in machines if m.id == 'septet']
+    require(len(owners) == 1, 'Expected one Septet machine')
+    slot = filter_id(owners[0])
+    require(slot == 8 or slot not in rules['effects'], 'Septet filter-only slot overlaps the SDK effect pool')
+    for machine in machines:
+        if machine.id == 'septet':
+            continue
+        require(machine.identity.get('effect') != slot, f'{machine.id} already occupies Septet filter {slot}')
+        for parent in (machine.root, *machine.root.parents):
+            manifest = parent / 'machine-bundle.json'
+            if manifest.is_file():
+                bundle = json.loads(manifest.read_bytes())
+                if bundle.get('id') == machine.id and parent / bundle.get('machine', '') == machine.root:
+                    require(f'filter:{slot}' not in bundle.get('claims', []),
+                            f'{machine.id} and Septet both require instrument filter {slot}')
+                    break
+    reserved = {v['page'] for v in [*FIXED_NUMBERS.values(), *(layout or {}).values()]}
+    reserved.update(m.identity['page'] for m in machines)
+    reserved.update(profile.get('m3_display_pages', {}).values())
+    reserved.update(bundle_page_claims(machines,rules['pages']))
+    free = [p for p in range(rules['pages']-2,rules['page_none'],-1) if p not in reserved]
+    require(free,'Septet needs one free display page')
+    profile['septet_page'] = free[0]
+    services = active_services(profile, service_users(machines))
+    require('master_filter' not in services,'Septet and the master processor both use receiver message 128')
+    if not trine:
+        profile['patches'].extend([
+            dict(kind='hook',address='0x8d506c3e',file_offset='0x13de9a',length=4,before='ffe37ffd',symbol='m3probe_filter_init',call=True),
+            dict(kind='hook',address='0x8c0b2a6c',file_offset='0xe9ca8',length=8,before='00e80200e505866f',symbol='m3_setup_click',call=False)])
+        copies = ROOT/'m3-copy-sites.json'
+        if copies.exists():
+            profile['patches'].extend(json.loads(copies.read_text()))
+    dispatch = {'m3probe_filter_init':'septet_filter_init','m3_setup_click':'sept_setup_click',
+                'sdk_master_receive':'sept_receive','m3_receive':'sept_receive',
+                'sdk_master_project':'sept_project','m3_project':'sept_project',
+                'sdk_project_new':'sept_new','m3_new':'sept_new','m3_step':'sept_step',
+                'sdk_lock_step':'sept_step','m3_copy':'sept_copy'}
+    if 'drum_sends' not in services:
+        dispatch['sdk_drum_send_gain_hook']='septet_sum_hook'
+    for patch in profile['patches']:
+        if patch.get('symbol') in dispatch:
+            patch['symbol']=dispatch[patch['symbol']]
+            patch.pop('service',None)
+    check_patch_boundaries(profile,len(profile['patches']))
